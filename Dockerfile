# Задаем образ для запуска Python 3.13 и готовым окружением uv
FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim

# Вызываем рабочую директорию /app, куда будут скопированы файлы проекта
WORKDIR /app

# Непосредственно копируем файлы зависимостей в рабочую директорию контейнера
COPY pyproject.toml uv.lock ./
# Устаналиваем зависимости проекта в виртуальное окружение uv
RUN uv sync --locked --no-dev

# Копируем файлы проекта в рабочую директорию контейнера
COPY hrv/ ./hrv/

# Запускаем скрипт анализа данных при старте контейнера
CMD ["/app/.venv/bin/python", "hrv/hrv_analysis.py"]